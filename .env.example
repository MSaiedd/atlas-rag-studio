# Local mode is loopback-only and needs no development API token.
ATLAS_AUTH_MODE=local
ATLAS_ALLOWED_HOSTS=localhost,127.0.0.1
ATLAS_DATABASE_URL=sqlite:///data/atlas.db
ATLAS_DATA_DIR=data
ATLAS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
ATLAS_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
ATLAS_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ATLAS_RERANKER_REVISION=1427fd652930e4ba29e8149678df786c240d8825
ATLAS_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
ATLAS_MODEL_REVISION=7ae557604adf67be50417f59c2c2f167def9a775
ATLAS_ADAPTER_PATH=artifacts/grounded-lora
ATLAS_OFFLINE=false
# PostgreSQL + Qdrant compose setup requires fresh private secrets:
# ATLAS_POSTGRES_PASSWORD=replace-with-a-random-password
# ATLAS_QDRANT_API_KEY=replace-with-a-random-service-key
# Public deployments require OIDC, real hostnames and TLS:
# ATLAS_AUTH_MODE=oidc
# ATLAS_OIDC_ISSUER=https://identity.example.com/
# ATLAS_OIDC_AUDIENCE=atlas
# ATLAS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ATLAS_ALLOWED_HOSTS=knowledge.example.com
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:password@postgres:5432/atlas
# ATLAS_QDRANT_URL=http://qdrant:6333
# External vLLM/TGI-compatible inference:
# ATLAS_LLM_BACKEND=compatible
# ATLAS_LLM_BASE_URL=http://inference:8000/v1
# ATLAS_MODEL_ID=your-base-model-name
# ATLAS_ADAPTER_MODEL=your-grounding-adapter-name
# ATLAS_LLM_API_KEY=server-side-provider-key
